# ── Python (Backend) ────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Entornos virtuales ──────────────────────────────────────
venv/
.venv/
env/

# ── Secretos / variables de entorno (NUNCA subir) ───────────
.env
.env.*
!.env.example
# .env.production del Frontend no lleva secretos, solo la URL real del
# backend — necesario que esté commiteado para que "npm run build" en
# cualquier máquina genere el build de producción correcto (Vite carga
# .env.local en TODOS los modos, incluido build; sin este archivo el build
# de producción quedaba apuntando al proxy de desarrollo /__api/).
!Frontend/.env.production
*.pem
*.key

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/.env.local

# ── Docs internos de contexto de sesión (no se suben; son para uso
# interno del desarrollo con Claude, no para el repo compartido) ──
INTEGRACION_FRONTEND_BACKEND.md
CLAUDE.md
.claude/

# ── Editor / SO ─────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Datos de migración y reportes con PII (NO subir) ────────
Backend/app/migration/
Backend/migration_output/
Backend/output_batch_advanced_v2025/
*.csv
*.xlsx
*.xls
