# Config para "npm run build" (producción — el sitio estático en S3, sin
# proxy de servidor detrás). Vite carga .env.local en TODOS los modos,
# incluido build, así que sin este archivo el build de producción heredaba
# el VITE_API_BASE_URL=/__api/ pensado solo para el proxy de desarrollo
# de Vite — una ruta que no existe en un sitio estático, y por eso el login
# fallaba con "servidor no disponible" en producción.
VITE_API_BASE_URL=https://api.glowup.unicornioindustries.co/
