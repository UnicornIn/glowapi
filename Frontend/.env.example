# Copia este archivo como .env.local y ajusta lo que necesites.

# URL base del API. Si se omite: localhost usa http://localhost:8000/ y
# cualquier otro host usa https://api-<hostname>/.
#
# Para exponer la app con un túnel (ngrok / cloudflared) usando UN solo túnel,
# deja el API en el mismo origen y que Vite lo reenvíe al backend local:
VITE_API_BASE_URL=/__api/

# Destino del proxy de desarrollo (por defecto http://localhost:8000).
# VITE_DEV_API_TARGET=http://localhost:8000
